Algoritmo "Voto"

Var
   AnoNasc, idade: inteiro



Inicio
      Escreva("Digite o seu ano de nascimento: ")
      Leia(AnoNasc)
      Idade<-2026 - AnoNasc
      Se Idade>= 16 ENTÃO
      Escreva("Você já pode emitir seu título de eleitor!")
      SeNao
      Escreva("Você ainda não tem idade para votar!")
      FimSe



Fimalgoritmo