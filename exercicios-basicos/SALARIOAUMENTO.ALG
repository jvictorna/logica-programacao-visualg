Algoritmo "SalarioAumento"

Var
   Salario, Aumento, SalarioA: real


Inicio
      Escreva("Digite o valor do seu salário mensal R$ ")
      Leia(Salario)
      Aumento<-(25 / 100)* Salario
      SalarioA<-Salario+Aumento
      Escreva("Seu novo salário com aumento de 25% é R$ ", SalarioA:7:2)
      

Fimalgoritmo