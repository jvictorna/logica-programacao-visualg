Algoritmo "Desconto"

Var
   Produto, Desc, ProdutoDesc: real


Inicio
      Escreva("Digite o valor do produto sem desconto: ")
      Leia(Produto)
      Desc<-(5 / 100)* Produto
      ProdutoDesc<-Produto-Desc
      Escreva("O valor do produto com desconto de 5% é R$ ", ProdutoDesc:6:2)

      
Fimalgoritmo