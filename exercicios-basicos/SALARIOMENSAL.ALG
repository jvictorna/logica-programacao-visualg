Algoritmo "SalarioMensal"

Var
   DiasTrab: inteiro
   VLDia, VLMensal: real


Inicio
      Escreva("Digite a quantidade de dias trabalhados no mês: ")
      Leia(DiasTrab)
      VLDia<-8 * 25
      VLMensal<-VLDia * DiasTrab
      Escreva("Seu salário no final do mês será R$ ", VLMensal:7:2)
      




Fimalgoritmo